<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="uav_traffic_world">

    <!-- 1. Systèmes essentiels de Gazebo (Physique, Commandes, Affichage 3D) -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- 2. Éclairage (Soleil) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <!-- 3. Sol / Arène de vol (90m x 90m correspondant aux bornes X/Y de l'EDA) -->
    <model name="ground_arena">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>90 90</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>90 90</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.25 0.3 1</ambient>
            <diffuse>0.2 0.25 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 4. Modèle 3D minimal du Drone (Quadrirotor) -->
    <model name="drone_1">
      <!-- Position initiale : X=0, Y=0, Z=5m -->
      <pose>0 0 5 0 0 0</pose>
      
      <link name="base_link">
        <!-- Désactive la chute libre tant que le contrôleur Python n'est pas branché -->
        <gravity>false</gravity>
        <inertial>
          <mass>1.2</mass>
          <inertia>
            <ixx>0.01</ixx><iyy>0.01</iyy><izz>0.02</izz>
          </inertia>
        </inertial>

        <!-- Corps central du drone -->
        <visual name="body_visual">
          <geometry>
            <box><size>0.35 0.35 0.12</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="body_collision">
          <geometry>
            <box><size>0.35 0.35 0.12</size></box>
          </geometry>
        </collision>

        <!-- Bras en croix (X) -->
        <visual name="arm_1">
          <pose>0 0 0 0 0 0.785</pose>
          <geometry><box><size>0.8 0.04 0.03</size></box></geometry>
          <material><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="arm_2">
          <pose>0 0 0 0 0 -0.785</pose>
          <geometry><box><size>0.8 0.04 0.03</size></box></geometry>
          <material><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>

        <!-- 4 Hélices / Rotors -->
        <visual name="rotor_front_left">
          <pose>0.28 0.28 0.04 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>0.01</length></cylinder></geometry>
          <material><diffuse>0.1 0.7 0.9 0.8</diffuse></material>
        </visual>
        <visual name="rotor_front_right">
          <pose>0.28 -0.28 0.04 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>0.01</length></cylinder></geometry>
          <material><diffuse>0.1 0.7 0.9 0.8</diffuse></material>
        </visual>
        <visual name="rotor_back_left">
          <pose>-0.28 0.28 0.04 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>0.01</length></cylinder></geometry>
          <material><diffuse>0.9 0.9 0.9 0.8</diffuse></material>
        </visual>
        <visual name="rotor_back_right">
          <pose>-0.28 -0.28 0.04 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>0.01</length></cylinder></geometry>
          <material><diffuse>0.9 0.9 0.9 0.8</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>